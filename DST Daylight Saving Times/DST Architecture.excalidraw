    {
      "id": "t-params",
      "type": "text",
      "x": 80,
      "y": 1860,
      "width": 840,
      "height": 210,
      "text": "Command 45 Params:\nParam1 = SiteOffset − OrgOffset (before DST) in seconds\nParam2 = SiteOffset − OrgOffset (after DST) in seconds\nParam3 = Unix timestamp of DST change  (946688400 = no DST in Windows)\n\nFM:    CommandID=45;Params=dword:{p1},dword:{p2},dword:{p3};\nMesa:  \"CommandId\":45,\"Param1\":{p1},\"Param2\":{p2},\"Param3\":{p3}",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "angle": 0,
      "strokeColor": "#1e1e2e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "seed": 1121,
      "version": 1,
      "versionNonce": 1121,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1716854400000,
      "link": null,
      "locked": false,
      "containerId": "r-params",
      "originalText": "Command 45 Params:\nParam1 = SiteOffset − OrgOffset (before DST) in seconds\nParam2 = SiteOffset − OrgOffset (after DST) in seconds\nParam3 = Unix timestamp of DST change  (946688400 = no DST in Windows)\n\nFM:    CommandID=45;Params=dword:{p1},dword:{p2},dword:{p3};\nMesa:  \"CommandId\":45,\"Param1\":{p1},\"Param2\":{p2},\"Param3\":{p3}",
      "lineHeight": 1.4
    },
