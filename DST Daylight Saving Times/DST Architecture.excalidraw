    {
      "id": "t-capi",
      "type": "text",
      "x": 500,
      "y": 1320,
      "width": 1300,
      "height": 180,
      "text": "Config.Api  (replaces DynaMiX.DeviceConfig — no longer actively developed)\nPOST /outdated-daylight-savings  →  get assets needing Command 45 (wrong or missing params)\nPOST /send-command-to-outdated-daylight-savings  →  send Command 45 to specific assets (List<AssetDSTCommand>)\nPOST /daylight-savings  →  send to ALL outdated assets for org (simplest call)\nPOST /organisations/daylight-savings  ·  POST /organisations/daylight-savings/mobile-units\nDaylightSavingsManager  →  MobileUnitCommandsManager  →  routes to FM or Mesa path",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "angle": 0,
      "strokeColor": "#1e1e2e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "seed": 1091,
      "version": 1,
      "versionNonce": 1091,
      "isDeleted": false,
      "groupIds": [],
      "frameId": null,
      "boundElements": [],
      "updated": 1716854400000,
      "link": null,
      "locked": false,
      "containerId": "r-capi",
      "originalText": "Config.Api  (replaces DynaMiX.DeviceConfig — no longer actively developed)\nPOST /outdated-daylight-savings  →  get assets needing Command 45 (wrong or missing params)\nPOST /send-command-to-outdated-daylight-savings  →  send Command 45 to specific assets (List<AssetDSTCommand>)\nPOST /daylight-savings  →  send to ALL outdated assets for org (simplest call)\nPOST /organisations/daylight-savings  ·  POST /organisations/daylight-savings/mobile-units\nDaylightSavingsManager  →  MobileUnitCommandsManager  →  routes to FM or Mesa path",
      "lineHeight": 1.4
    },
