    {
      "id": "t-client",
      "type": "text",
      "x": 500,
      "y": 1080,
      "width": 1300,
      "height": 120,
      "text": "MiX.ConfigInternal.Api.Client  (HTTP client — replaces old DeviceConfigClient)\nGetAssetsWithOutdatedDaylightSavingsCommands(authToken, DaylightSavingsCommand)  →  POST /outdated-daylight-savings\nSendCommandsToAssetsWithOutdatedDaylightSavingsCommands(authToken, List<AssetDSTCommand>)  →  POST /send-command-to-outdated-daylight-savings\nSendDaylightSavingsCommandToMobileUnits(authToken, DaylightSavingsCommand)  →  POST /daylight-savings",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "angle": 0,
      "strokeColor": "#1e1e2e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
