      "updated": 1710720000000,
      "link": null,
      "locked": false,
      "text": "Param1 = SiteOffset − OrgOffset before DST (seconds)\nParam2 = SiteOffset − OrgOffset after DST (seconds)\nParam3 = Unix timestamp of DST change  (946688400 = no DST in Windows)\nFM: CommandID=45;Params=dword:{p1},dword:{p2},dword:{p3};\nMesa: \"CommandId\":45,\"Param1\":{p1},\"Param2\":{p2},\"Param3\":{p3}",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "r-params",
      "originalText": "Param1 = SiteOffset − OrgOffset before DST (seconds)\nParam2 = SiteOffset − OrgOffset after DST (seconds)\nParam3 = Unix timestamp of DST change  (946688400 = no DST in Windows)\nFM: CommandID=45;Params=dword:{p1},dword:{p2},dword:{p3};\nMesa: \"CommandId\":45,\"Param1\":{p1},\"Param2\":{p2},\"Param3\":{p3}",
      "lineHeight": 1.4
    },
